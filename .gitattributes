# Keep the working tree LF everywhere (EditorConfig + Prettier both write LF).
# Prevents global core.autocrlf from producing phantom-dirty checkouts.
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary

# The reviewed PDF is a binary document; text exports use the repository LF convention.
docs/alife/*.pdf binary

# GitHub Linguist classification: prevent large HTML/JSON report bundles and static
# site builds from drowning out Zig, C++, and TypeScript in the GitHub Languages bar,
# and classify Eshkol (.esk) files as detectable Scheme-family code until upstream
# github-linguist/linguist merges a native Eshkol grammar entry.
docs/**/*.html linguist-documentation=true
docs/alife/** linguist-documentation=true
site/** linguist-generated=true
lab/*.json linguist-generated=true
src/math/zig-wasm-binary.ts linguist-generated=true
src/generated/** linguist-generated=true
zig/**/*.zig linguist-detectable=true
native/**/*.cpp linguist-detectable=true
native/**/*.hpp linguist-detectable=true
*.esk linguist-language=Scheme linguist-detectable=true
# Linguist already skips `docs/` by default, so the line above leaves the HTML total unchanged; the
# HTML that counts lives at the root and in the verbatim archive. Measured with `github-linguist`
# on the committed tree, these lines take HTML 5.57% -> 2.97% and Zig 0.50% -> 0.52%. Live app
# pages (index.html, lab/*.html) stay counted.
docs.html linguist-documentation=true
specs.html linguist-documentation=true
bible.html linguist-generated=true
alife-gallery.js linguist-generated=true
legacy/** linguist-vendored=true
