{
  "name": "cosmogonic-quantum-mechalogodrom",
  "version": "0.23.0",
  "packageManager": "bun@1.3.14",
  "description": "An experimental artificial life platform for embodied synthetic cognition and procedural morphogenesis, from individual beings to worlds across scales. Combines adaptive minds, computational physics and simulated quantum systems with expressive 3D forms, live inspection and causal experiments.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "0thernes Corp <0_0@0thernes.art> (https://0thernes.art)",
  "homepage": "https://0thernes.github.io/cosmogonic-quantum-mechalogodrom/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0thernes/cosmogonic-quantum-mechalogodrom.git"
  },
  "bugs": {
    "url": "https://github.com/0thernes/cosmogonic-quantum-mechalogodrom/issues"
  },
  "keywords": [
    "artificial-life",
    "alife",
    "webgl",
    "three-js",
    "bun",
    "typescript",
    "deterministic-simulation",
    "quantum",
    "consciousness",
    "nhsi",
    "xenomimics",
    "generative",
    "procedural",
    "tsotchke",
    "eshkol",
    "moonlab",
    "qgtl",
    "qrng",
    "libirrep",
    "sbnn",
    "zig",
    "webassembly",
    "quantum-computing"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/install-hooks.ts",
    "predev": "bun scripts/sync-guard.ts && bun run gen:alife && bun scripts/gen-bible-corpus.ts && bun scripts/build.ts",
    "dev": "bun scripts/harvest-tsotchke-corpus.ts && bun --hot server.ts",
    "pull": "bun scripts/sync-local.ts",
    "guard": "bun scripts/sync-guard.ts",
    "start": "bun server.ts",
    "build": "bun run gen:alife && bun scripts/gen-bible-corpus.ts && bun scripts/gen-consciousness-lab-data.ts && bun scripts/build.ts",
    "pages": "bun run build && bun scripts/build-pages.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server.ts tests bench scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun scripts/verify-receipts.ts",
    "sbom": "bun scripts/sbom.ts",
    "bench": "bun bench/index.ts",
    "bench:nhi-grid": "bun scripts/bench-nhi-current-grid.ts",
    "filemap": "bun scripts/gen-filemap.ts",
    "filemap:check": "bun scripts/gen-filemap.ts --check",
    "generated:check": "bun scripts/check-generated.ts",
    "metrics": "bun scripts/codebase-metrics.ts",
    "verify:facts": "bun scripts/verify-canonical-facts.ts --check",
    "check:static": "bun run format:check && bun run typecheck && bun run lint",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run verify:receipts && bun run sync:check && bun run verify:facts && bun run evidence:phase-b:mechanisms:check && bun run filemap:check && bun run build && bun run generated:check",
    "verify:receipts": "bun scripts/verify-receipts.ts",
    "sync": "bun scripts/sync-surfaces.ts",
    "sync:check": "bun scripts/sync-surfaces.ts --check",
    "gen:bible": "bun scripts/gen-bible-corpus.ts",
    "gen:alife": "bun scripts/alife-comparison-stats.ts && bun scripts/alife-comparison-geometry.ts && bun scripts/alife-codeground-sensitivity.ts && bun scripts/gen-alife-landscape-report.ts && bun scripts/gen-capability-profile.ts && bun scripts/gen-alife-embed.ts",
    "report:alife-landscape": "bun run gen:alife && bun scripts/gen-alife-landscape-report.ts --pdf output/alife-landscape/cosmogonic-alife-landscape-index.pdf",
    "bench:organism-intelligence": "bun scripts/organism-intelligence-benchmark.ts",
    "evidence:phase-b:mechanisms": "bun scripts/organism-intelligence-phase-b/mechanism-evidence-artifacts.ts",
    "evidence:phase-b:mechanisms:check": "bun scripts/organism-intelligence-phase-b/mechanism-evidence-artifacts.ts --check",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "smoke:visual": "bun scripts/browser-visual-smoke.ts",
    "harvest:tsotchke": "bun scripts/harvest-tsotchke-corpus.ts",
    "sync:tsotchke": "bun scripts/harvest-tsotchke-corpus.ts --sync-mirrors",
    "build:zig": "bun scripts/build-zig.ts",
    "test:linear-economy": "bun test tests/rfc-d-linear-economy.test.ts tests/rfc-d-agent-dual-hold.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@noble/hashes": "^2.2.0",
    "d3-delaunay": "^6.0.4",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "htmx.org": "^2.0.10",
    "mermaid": "^11.16.0",
    "simple-statistics": "^7.9.3",
    "simplex-noise": "^4.0.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/d3-delaunay": "^6.0.4",
    "@types/three": "0.185.1",
    "bun-plugin-tailwind": "^0.1.2",
    "mitata": "^1.0.34",
    "oxlint": "^1.73.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "^3.4.11"
  }
}
